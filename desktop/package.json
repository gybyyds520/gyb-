{
  "name": "xqfx-desktop",
  "productName": "学情分析系统",
  "version": "1.0.0",
  "description": "学情预测分析系统 · Windows 桌面端（Web 构建产物封装）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:web": "cd ..\\web && set VITE_API_BASE=http://127.0.0.1:8080/api&& npm run build -- --outDir ..\\desktop\\dist",
    "start": "electron .",
    "pack": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.gyb.xqfx.desktop",
    "productName": "学情分析系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "dist/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "学情分析系统"
    },
    "portable": {
      "artifactName": "学情分析系统-绿色版-${version}.exe"
    }
  }
}
